######################################
# 🔧 ENVIRONNEMENT VITE & GOURMAND
######################################

APP_NAME=vitegourmand
APP_ENV=local
TZ=Europe/Paris

######################################
# 🗄️ BASE DE DONNÉES RELATIONNELLE (MySQL)
######################################
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=vg
MYSQL_USER=vg
MYSQL_PASSWORD=vgpass

######################################
# 📊 BASE DE DONNÉES NoSQL (MongoDB)
######################################
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=vgroot
MONGO_INITDB_ROOT_PASSWORD=vgrootpass
MONGO_DATABASE=vg

######################################
# 🧮 INTERFACES WEB
######################################
APP_PORT=8080
PMA_PORT=8090
MONGO_EXPRESS_PORT=8081

######################################
# 💌 SERVEUR SMTP DE TEST (Mailhog)
######################################
MAILHOG_HOST=mailhog
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

######################################
# ✅ FIN DU FICHIER
######################################

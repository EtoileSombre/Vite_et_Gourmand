
# ============================================================
# ENVIRONNEMENT VITE & GOURMAND (.env.example)
# Copiez ce fichier sous le nom `.env` et adaptez les valeurs
# ============================================================

COMPOSE_PROJECT_NAME=vg_prod

APP_NAME=vitegourmand
APP_ENV=production
APP_URL=https://viteetgourmand.com
TZ=Europe/Paris

# BASE DE DONNÉES RELATIONNELLE (MySQL)

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=vite_et_gourmand
MYSQL_USER=vguser
MYSQL_PASSWORD=CHANGE_ME

# BASE DE DONNÉES NoSQL (MongoDB)

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=vgroot
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_DATABASE=vg
MONGO_URI=mongodb://vgroot:CHANGE_ME@mongo:27017

# INTERFACES WEB

APP_PORT=80
PMA_PORT=32770
MONGO_EXPRESS_PORT=32772

# MAILHOG (dev)

MAILHOG_HOST=mailhog
MAILHOG_UI_PORT=8026
MAILHOG_SMTP_PORT=1026

# SMTP (production)

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contact@example.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=contact@example.com
MAIL_FROM_NAME=Vite & Gourmand

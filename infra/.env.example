
# 🔧 ENVIRONNEMENT VITE & GOURMAND (.env.example)
# Copiez ce fichier sous le nom `.env` pour démarrer l'application


COMPOSE_PROJECT_NAME=vg_dev

APP_NAME=vg_dev
APP_ENV=local
APP_URL=http://72.62.233.13:8082
TZ=Europe/Paris

#🗄️ BASE DE DONNÉES RELATIONNELLE (MySQL)

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=vgrootpass
MYSQL_DATABASE=vite_et_gourmand
MYSQL_USER=vguser
MYSQL_PASSWORD=vgrootpass

#📊 BASE DE DONNÉES NoSQL (MongoDB)

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=vgroot
MONGO_INITDB_ROOT_PASSWORD=vgrootpass
MONGO_DATABASE=vg
MONGO_URI=mongodb://vgroot:vgrootpass@mongo:27017

#🧮 INTERFACES WEB

APP_PORT=8082
PMA_PORT=8090
PHPMYADMIN_PORT=8090
MONGO_EXPRESS_PORT=8084
MONGOEXPRESS_PORT=8084

#💌 SERVEUR SMTP DE TEST (Mailhog)

MAILHOG_HOST=mailhog
MAILHOG_UI_PORT=8026
MAILHOG_SMTP_PORT=1026

# CONFIGURATION MAIL (PHPMailer)

# DEV (MailHog)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@viteetgourmand.com
MAIL_FROM_NAME="Vite & Gourmand (DEV)"


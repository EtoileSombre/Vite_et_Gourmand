# Configuration UTF-8
AddDefaultCharset UTF-8

# Variables d'environnement (à configurer selon votre environnement)
# En production, décommentez et configurez ces valeurs :
# SetEnv APP_ENV production
# SetEnv MAIL_HOST smtp.hostinger.com
# SetEnv MAIL_PORT 587
# SetEnv MAIL_ENCRYPTION tls
# SetEnv MAIL_USERNAME contact@viteetgourmand.com
# SetEnv MAIL_PASSWORD votre_mot_de_passe_email
# SetEnv MAIL_FROM_ADDRESS contact@viteetgourmand.com
# SetEnv MAIL_FROM_NAME "Vite & Gourmand"

# Active la réécriture d'URL
RewriteEngine On

# Redirige toutes les requêtes vers index.php (sauf les fichiers existants)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Empêche l'accès aux fichiers sensibles
<FilesMatch "\.(env|sql|log|md|git|gitignore|xml|yml|yaml|json|lock|txt|sh)$">
    Require all denied
</FilesMatch>

# Protection des dossiers sensibles via RewriteRule (compatible .htaccess)
RewriteRule "(^|/)\." - [F,L]

# Headers de sécurité avancés
<IfModule mod_headers.c>
    # Protection XSS
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    
    # HSTS - Force HTTPS (activez uniquement si SSL configuré)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Politique de référents
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (CSP)
    # À ajuster selon vos besoins (Google Fonts, Bootstrap CDN, etc.)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'"
    
    # Permissions Policy (anciennement Feature Policy)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # Retire le header X-Powered-By pour masquer la version PHP
    Header unset X-Powered-By
</IfModule>

# Cache des ressources statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Compression Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Désactive l'indexation des répertoires
Options -Indexes

# Protection contre les injections de fichiers et attaques courantes
<IfModule mod_rewrite.c>
    # Blocage des tentatives XSS dans les paramètres
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    # Blocage manipulation des variables globales PHP
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
    # Blocage tentatives d'inclusion de fichiers
    RewriteCond %{QUERY_STRING} (\.\.\/|\.\.\\) [OR]
    # Blocage tentatives SQL injection basiques
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table) [NC,OR]
    # Blocage tentatives de commandes système
    RewriteCond %{QUERY_STRING} (wget|curl|exec|system|shell_exec) [NC]
    # Si une condition correspond, bloquer (403 Forbidden)
    RewriteRule .* - [F,L]
</IfModule>

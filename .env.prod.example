# 🚀 CONFIGURATION PRODUCTION - Vite & Gourmand

# Environnement
APP_ENV=production
TZ=Europe/Paris

# 🗄️ MySQL (adapter selon votre VPS)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vite_et_gourmand
MYSQL_USER=vg_user
MYSQL_PASSWORD=CHANGEME_SECURE_PASSWORD

# 📊 MongoDB (adapter selon votre VPS)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=mongouser
MONGO_INITDB_ROOT_PASSWORD=CHANGEME_SECURE_PASSWORD
MONGO_DATABASE=vg
MONGO_URI=mongodb://mongouser:CHANGEME_SECURE_PASSWORD@localhost:27017

# SMTP Hostinger
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contact@viteetgourmand.com
MAIL_PASSWORD=CHANGEME_YOUR_EMAIL_PASSWORD
MAIL_FROM_ADDRESS=contact@viteetgourmand.com
MAIL_FROM_NAME="Vite & Gourmand"

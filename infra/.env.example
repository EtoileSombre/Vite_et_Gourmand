
# 🔧 ENVIRONNEMENT VITE & GOURMAND (.env.example)
# Copiez ce fichier sous le nom `.env` pour démarrer l'application


COMPOSE_PROJECT_NAME=vg_prod

APP_NAME=vitegourmand
APP_ENV=prod
APP_URL=https://viteetgourmand.com
TZ=Europe/Paris

#🗄️ BASE DE DONNÉES RELATIONNELLE (MySQL)

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=vgrootpass
MYSQL_DATABASE=vite_et_gourmand
MYSQL_USER=vguser
MYSQL_PASSWORD=vgpass

#📊 BASE DE DONNÉES NoSQL (MongoDB)

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=vgroot
MONGO_INITDB_ROOT_PASSWORD=vgrootpass
MONGO_DATABASE=vg
MONGO_URI=mongodb://vgroot:vgrootpass@mongo:27017

#🧮 INTERFACES WEB

APP_PORT=80
PMA_PORT=32770
MONGO_EXPRESS_PORT=32772

# SMTP PROD (Hostinger)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contact@viteetgourmand.com
MAIL_PASSWORD="Vite&gourmand2026"
MAIL_FROM_ADDRESS=contact@viteetgourmand.com
MAIL_FROM_NAME="Vite & Gourmand"

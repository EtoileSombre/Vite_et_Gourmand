
# 🔧 ENVIRONNEMENT VITE & GOURMAND (.env.example)
# Copiez ce fichier sous le nom `.env` puis remplissez vos valeurs


APP_NAME=vitegourmand
APP_ENV=local
TZ=Europe/Paris

#🗄️ BASE DE DONNÉES RELATIONNELLE (MySQL)

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=vitegourmand
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

#📊 BASE DE DONNÉES NoSQL (MongoDB)

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=CHANGE_ME
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_DATABASE=vitegourmand_nosql

#🧮 INTERFACES WEB

APP_PORT=8080
PMA_PORT=8090
MONGO_EXPRESS_PORT=8081

#💌 SERVEUR SMTP DE TEST (Mailhog)

MAILHOG_HOST=mailhog
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025


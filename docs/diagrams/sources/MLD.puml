@startuml MLD - Vite & Gourmand

title Modèle Logique de Données - Vite & Gourmand

hide circle
skinparam linetype ortho

!define TABLE class

TABLE utilisateur {
  utilisateur_id
  --
  email
  password
  prenom
  nom
  telephone
  adresse_postale
  actif
  role_id
}

TABLE role {
  role_id
  --
  libelle
}

TABLE menu {
  menu_id
  --
  titre
  prix_par_personne
  nombre_personne_minimum
  quantite_restante
  description
  regime_id
  theme_id
}

TABLE commande {
  numero_commande
  --
  date_commande
  date_prestation
  nombre_personne
  prix_total
  statut
  utilisateur_id
  menu_id
}

TABLE avis {
  avis_id
  --
  note
  description
  statut
  numero_commande
  utilisateur_id
}

TABLE plat {
  plat_id
  --
  titre_plat
  photo
}

TABLE regime {
  regime_id
  --
  libelle
}

TABLE theme {
  theme_id
  --
  libelle
}

TABLE allergene {
  allergene_id
  --
  libelle
}

TABLE suivi_commande {
  suivi_id
  --
  ancien_statut
  nouveau_statut
  date_changement
  numero_commande
}

TABLE contact {
  contact_id
  --
  titre
  description
  email
  traite
}

TABLE horaire {
  jour
  --
  heure_ouverture
  heure_fermeture
}

' Tables de liaison (N:N)

TABLE propose {
  menu_id
  plat_id
}

TABLE associe_theme {
  menu_id
  theme_id
}

TABLE contient {
  plat_id
  allergene_id
}

' Relations (FK)

utilisateur "N" --> "1" role
utilisateur "1" --> "N" commande
utilisateur "1" --> "N" avis

commande "N" --> "1" menu
commande "1" --> "N" suivi_commande
commande "1" --> "0..1" avis

menu "N" --> "0..1" regime

' Relations N:N via tables de liaison
menu "N" --> "N" propose
propose "N" --> "N" plat

menu "N" --> "N" associe_theme
associe_theme "N" --> "N" theme

plat "N" --> "N" contient
contient "N" --> "N" allergene

note bottom
  16 tables (normalisé 3NF)
end note

@enduml

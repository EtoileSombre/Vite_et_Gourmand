
# 🔧 ENVIRONNEMENT VITE & GOURMAND (.env.example)
# Copiez ce fichier sous le nom `.env` pour démarrer l'application


APP_NAME=vitegourmand
APP_ENV=local
TZ=Europe/Paris

#🗄️ BASE DE DONNÉES RELATIONNELLE (MySQL)

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=vitegourmand_root_2025
MYSQL_DATABASE=vitegourmand
MYSQL_USER=vitegourmand_user
MYSQL_PASSWORD=vitegourmand_pass_2025

#📊 BASE DE DONNÉES NoSQL (MongoDB)

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mongo_pass_2025
MONGO_DATABASE=vitegourmand_nosql

#🧮 INTERFACES WEB

APP_PORT=8080
PMA_PORT=8090
MONGO_EXPRESS_PORT=8081

#💌 SERVEUR SMTP DE TEST (Mailhog)

MAILHOG_HOST=mailhog
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

